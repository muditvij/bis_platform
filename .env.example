# === Groq API Configuration ===
GROQ_API_KEY=gsk_your_groq_api_key_here

# === Models ===
GROQ_MODEL_ANSWER=llama-3.3-70b-versatile
GROQ_MODEL_ROUTER=llama-3.1-8b-instant

# === Neo4j GraphRAG Configuration ===
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=
AURA_INSTANCENAME=

# === Storage Paths & Embeddings ===
CHROMA_PERSIST_DIR=./chroma_data
SQLITE_PATH=./bis_metadata.db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# === Server Configuration ===
PORT=8000
SECRET_KEY=bis_sahayak_secret_key_hackathon_demo

# === Deployment Public IP (populated dynamically) ===
PUBLIC_IP=
